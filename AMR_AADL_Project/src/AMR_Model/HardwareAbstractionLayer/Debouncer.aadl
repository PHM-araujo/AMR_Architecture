package HardwareAbstractionLayer
public

	-- Definição do debouncer para filtragem de sinais de hardware
	system Debouncer
		features
			event_in : in event port;
			event_out : out event port;
	end Debouncer;

	system implementation Debouncer.impl
		properties
			Compute_Execution_Time => 2 ms..5 ms;
	end Debouncer.impl;

end HardwareAbstractionLayer;
