package HardwareAbstractionLayer
public

	-- Definição do manipulador de interrupções
	system InterruptHandler
		features
			event_in : in event port;
			event_out : out event port;
	end InterruptHandler;

	system implementation InterruptHandler.impl
		properties
			Compute_Execution_Time => 1 ms..3 ms;
	end InterruptHandler.impl;

end HardwareAbstractionLayer;
