package UserInterfaceAndMonitoringLayer
public

	-- Definição do sistema de monitoramento
	system MonitoringSystem
		features
			status_out : out event data port;
	end MonitoringSystem;

	system implementation MonitoringSystem.impl
		properties
			Compute_Execution_Time => 15 ms..25 ms;
	end MonitoringSystem.impl;

end UserInterfaceAndMonitoringLayer;
