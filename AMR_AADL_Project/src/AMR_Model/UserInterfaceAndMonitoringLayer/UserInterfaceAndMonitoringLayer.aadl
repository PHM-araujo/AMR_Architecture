package UserInterfaceAndMonitoringLayer
public

	-- Definição da camada de interface do usuário e monitoramento
	system UserInterfaceAndMonitoringLayer
		features
			status_in : in event data port;
			user_cmd : out event data port;
	flows
		f1: flow path status_in -> user_cmd;
	end UserInterfaceAndMonitoringLayer;

	system implementation UserInterfaceAndMonitoringLayer.impl
		subcomponents
			user_interface : system UserInterface.impl;
			monitoring_system : system MonitoringSystem.impl;
		connections
			conn1 : port monitoring_system.status_out -> user_interface.status_in;
	end UserInterfaceAndMonitoringLayer.impl;

end UserInterfaceAndMonitoringLayer;
