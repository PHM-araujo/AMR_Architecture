package ApplicationLogicLayer
public

	-- Definição do controlador de missão
	system MissionController
		features
			event_in : in event port;
			cmd_out : out event port;
	end MissionController;

	system implementation MissionController.impl
		properties
			Period => 100 ms;
			Compute_Execution_Time => 10 ms..20 ms;
	end MissionController.impl;

end ApplicationLogicLayer;
