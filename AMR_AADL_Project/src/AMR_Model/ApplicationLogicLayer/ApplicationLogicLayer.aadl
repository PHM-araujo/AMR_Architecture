package ApplicationLogicLayer
public

	-- Definição da camada de lógica de aplicação
	system ApplicationLogicLayer
		features
			mission_update : in event data port;
			navigation_cmd : out event data port;
	flows
		f1: flow path mission_update -> navigation_cmd;
	end ApplicationLogicLayer;

	system implementation ApplicationLogicLayer.impl
		subcomponents
			notify_manager : system NotifyManager.impl;
			mission_controller : system MissionController.impl;
			navigation_system : system NavigationSystem.impl;
			safety_system : system SafetySystem.impl;
		connections
			conn1 : port notify_manager.event_out -> mission_controller.event_in;
			conn2 : port mission_controller.cmd_out -> navigation_system.cmd_in;
			conn3 : port navigation_system.cmd_out -> safety_system.cmd_in;
	end ApplicationLogicLayer.impl;

end ApplicationLogicLayer;
